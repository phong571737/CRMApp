<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/bottomhoatdong"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="2000dp"
    android:orientation="vertical"
    android:background="@drawable/bottomsheet_rounded_top"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Header: Tên hoạt động + Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cuộc gọi"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/ic_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_escape"
            android:contentDescription="Cancel"/>
    </LinearLayout>

    <!-- Tab hoạt động -->
    <LinearLayout
        android:id="@+id/tab_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="30dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp">

        <ImageView
            android:id="@+id/ic_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/rounded_input_box_small"
            android:src="@drawable/ic_call"
            android:scaleType="centerInside"/>

        <ImageView
            android:id="@+id/ic_meeting"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="150dp"
            android:background="@drawable/rounded_input_box_small"
            android:src="@drawable/ic_meeting"
            android:scaleType="centerInside"/>
    </LinearLayout>

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom thông tin -->
    <LinearLayout
        android:id="@+id/bottomthongtin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:weightSum="2"
        android:padding="8dp">

        <!-- Thông tin -->
        <LinearLayout
            android:id="@+id/thongtin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Người phụ trách -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_weight="2">

                <ImageView
                    android:id="@+id/ic_face2"
                    android:layout_width="15dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/nhanvienlist"
                    android:visibility="gone"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/nguoiphutrach"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nguoiphutrach"
                        android:textColor="@color/gray1"
                        android:textSize="@dimen/text_small" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_input_box">

                        <AutoCompleteTextView
                            android:id="@+id/actnguoiphutrach"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="@dimen/text14"
                            android:paddingStart="@dimen/margin_base"
                            android:background="@android:color/transparent"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thời gian -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/titlethoigian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bắt đầu - Kết thúc"
                    android:textColor="@color/gray1"
                    android:textSize="@dimen/text_small" />

                <!-- Thời gian bắt đầu -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="@dimen/margin15">

                    <TextView
                        android:id="@+id/ngaybatdau"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15-11-2025"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/giobatdau"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin7"
                        android:text="13:15"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Thời gian kết thúc -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/ngayketthuc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15-11-2025"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/gioketthuc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:30"
                        android:textSize="12sp"
                        android:layout_marginStart="@dimen/margin7"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Trạng thái + Lưu -->
        <LinearLayout
            android:id="@+id/bottomtrangthai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/margin15"
            android:layout_marginEnd="@dimen/margin15"
            android:padding="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_input_box">

                <AutoCompleteTextView
                    android:id="@+id/acttrangthai"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="none"
                    android:text="Lên kế hoạch"
                    android:textSize="@dimen/text14"
                    android:paddingStart="@dimen/margin_base"
                    android:background="@android:color/transparent"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLuu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:text="@string/save"
                android:backgroundTint="@color/blue2"
                app:cornerRadius="@dimen/bottom_padding"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>