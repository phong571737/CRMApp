<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 🔹 PHẦN CỐ ĐỊNH (HEADER + THÔNG TIN CƠ BẢN) -->
    <ScrollView
        android:id="@+id/headerScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header với nút back -->
            <LinearLayout
                android:id="@+id/chitietnguoilienhe_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ic_back"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/arrow_back" />

                <TextView
                    android:id="@+id/chitietnguoilienhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chitietnguoilienhe"
                    android:textSize="@dimen/text_large"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Contact -->
            <LinearLayout
                android:id="@+id/nguoilienhe_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_basex3"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ic_contact"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user" />

                <TextView
                    android:id="@+id/tennguoilienhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_large"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- SDT + Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_basex3"
                android:orientation="horizontal">

                <!-- Số điện thoại -->
                <LinearLayout
                    android:id="@+id/sdt_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sodienthoai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Số điện thoại"
                        android:textSize="@dimen/text_small" />

                    <ImageView
                        android:id="@+id/ic_phone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_call" />
                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:id="@+id/email_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="48dp"
                        android:text="Email"
                        android:textSize="@dimen/text_small" />

                    <ImageView
                        android:id="@+id/ic_mail"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_mail" />
                </LinearLayout>
            </LinearLayout>

            <!-- Công ty -->
            <TextView
                android:id="@+id/rowcongty"
                android:layout_marginTop="@dimen/margin_basex3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_small"
                android:text="@string/congty"
                android:layout_marginStart="8dp"/>

            <!-- Người tạo , người phụ trách -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_basex3">


                <!-- Người phụ trách -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ic_face2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_face2" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/nguoiphutrach"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nguoiphutrach"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/tennguoiphutrach"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn Minh Hà"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 🔹 TAB NAVIGATION -->
    <LinearLayout
        android:id="@+id/tab_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_basex3"
        app:layout_constraintTop_toBottomOf="@id/headerScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_tongquan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tongquan"
            android:textColor="@color/blue"
            android:gravity="center"
            android:background="@drawable/edittext_line"
            android:textSize="@dimen/text_small" />


        <TextView
            android:id="@+id/tab_chitiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chitiet"
            android:gravity="center"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/tab_cohoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cơ hội"
            android:gravity="center"
            android:textSize="@dimen/text_small" />

<!--        <TextView-->
<!--            android:id="@+id/tab_hoatdong"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Hoạt động"-->
<!--            android:textColor="@color/grey"-->
<!--            android:textSize="14sp"-->
<!--            android:padding="8dp"-->
<!--            android:layout_marginStart="16dp" />-->

<!--        <TextView-->
<!--            android:id="@+id/tab_cohoi"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Cơ hội"-->
<!--            android:textColor="@color/grey"-->
<!--            android:textSize="14sp"-->
<!--            android:padding="8dp"-->
<!--            android:layout_marginStart="16dp" />-->
    </LinearLayout>

    <!-- 🔹 NỘI DUNG FRAGMENT THAY ĐỔI -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tab_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
