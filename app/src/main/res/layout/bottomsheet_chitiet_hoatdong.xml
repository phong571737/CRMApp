<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottomsheet_rounded_top">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ic_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_escape"
            android:contentDescription="Đóng" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chi tiết hoạt động"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center" />

<!--        <ImageView-->
<!--            android:id="@+id/ic_more"-->
<!--            android:layout_width="24dp"-->
<!--            android:layout_height="24dp"-->
<!--            android:src="@drawable/ic_more_vert"-->
<!--            android:contentDescription="Thêm" />-->

    </LinearLayout>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tên hoạt động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tên hoạt động:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_tenhoatdong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

<!--            &lt;!&ndash; Tiêu đề &ndash;&gt;-->
<!--            <LinearLayout-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:orientation="horizontal"-->
<!--                android:paddingVertical="12dp">-->

<!--                <TextView-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_weight="1"-->
<!--                    android:text="Tiêu đề:"-->
<!--                    android:textSize="14sp"-->
<!--                    android:textColor="@color/black" />-->

<!--                <TextView-->
<!--                    android:id="@+id/tv_tieude"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text=""-->
<!--                    android:textSize="14sp"-->
<!--                    android:textColor="@color/gray1" />-->
<!--            </LinearLayout>-->

            <!-- Mô tả -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mô tả:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_mota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Người dùng được mời -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Người dùng được mời:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_nguoidungduocmoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Công ty -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Công ty:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_congty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Cá nhân -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cá nhân:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_canhan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Cơ hội -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cơ hội:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_cohoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Người phụ trách -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Người phụ trách:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_nguoiphutrach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

            <!-- Tình trạng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tình trạng:"
                    android:textSize="14sp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_tinhtrang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không xác định"
                    android:textSize="14sp"
                    android:textColor="@color/gray1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Nút Hoàn thành -->
    <Button
        android:id="@+id/btn_hoanthanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="Hoàn thành"
        android:textColor="@android:color/white"
        android:background="@drawable/rounded_input_box"
        android:backgroundTint="@color/blue"
        android:textSize="16sp"
        android:padding="16dp" />

</LinearLayout>
