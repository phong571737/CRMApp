<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- 🔹 Hoạt động đã lên lịch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card">

        <!-- Header section (title + collapse icon) -->
        <LinearLayout
            android:id="@+id/layout_scheduled_activities_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_scheduled_activities_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoạt động đã lên lịch"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <ImageView
                android:id="@+id/iv_scheduled_activities_toggle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_up" />
        </LinearLayout>

        <!-- Empty state content -->
        <LinearLayout
            android:id="@+id/layout_empty_activities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_empty_activities_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_emptybox" />

            <TextView
                android:id="@+id/tv_empty_activities_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không có nội dung"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_empty_activities_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hãy bổ sung hoạt động liên quan!"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_add_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Thêm hoạt động"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginVertical="16dp"/>
        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHoatDong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="@dimen/margin_basex3"/>
    </LinearLayout>



