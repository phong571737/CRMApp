<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_input_box"
    android:layout_marginTop="@dimen/margin_basex3"
    android:paddingStart="30dp"
    android:paddingEnd="@dimen/margin_base"
    android:paddingTop="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_base">

    <!-- 🔹 DÒNG 1: Icon + Tên cuộc họp + More -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ic_type"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_meeting"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/filltencuochop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_basex2"
            android:text="Họp demo quy trình CTKM"
            android:textStyle="bold"
            android:textSize="@dimen/text_medium" />

<!--        <ImageView-->
<!--            android:id="@+id/ic_more"-->
<!--            android:layout_width="20dp"-->
<!--            android:layout_height="20dp"-->
<!--            android:src="@drawable/ic_more_vert"-->
<!--            app:tint="@color/blue" />-->
    </LinearLayout>
    <TextView
        android:id="@+id/fillcohoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_basex2"
        android:layout_marginTop="@dimen/margin_base"
        android:text=""
        android:textStyle="bold"
        android:textSize="@dimen/text_medium"
        android:visibility="gone" />

    <!-- 🔹 DÒNG 2: Thời gian -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_basex2">

        <ImageView
            android:id="@+id/ic_calendar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_calendar"
            android:tint="@color/black" />

        <TextView
            android:id="@+id/fillgiobatdau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_basex2"
            android:text="09:30"
            android:textSize="@dimen/text_medium" />

        <TextView
            android:id="@+id/fillgioketthuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_basex2"
            android:text="11:30"
            android:textSize="@dimen/text_medium" />

        <TextView
            android:id="@+id/fillngay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_basex2"
            android:text="19/08/2024"
            android:textSize="@dimen/text_medium" />
    </LinearLayout>

    <!-- 🔹 DÒNG 3: Trạng thái + Comment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_basex2">

        <TextView
            android:id="@+id/filltrangthai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_color"
            android:text="Lên kế hoạch"
            android:textSize="@dimen/text_medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

    </LinearLayout>


</LinearLayout>
