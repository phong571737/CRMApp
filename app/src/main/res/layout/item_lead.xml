<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/light_gray"
    android:backgroundTint="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!--Name-->
        <LinearLayout
            android:id="@+id/ll_cus_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_user"
                android:contentDescription="@null"
                app:tint="@color/color_icon"
                />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:text="@string/cus_name" />

            <ImageButton
                android:id="@+id/iv_dots"
                android:contentDescription="@null"
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_more_vert"
                android:background="@android:color/transparent"
                app:tint="@color/gray_dark"
                />

        </LinearLayout>
        <!--end name-->

        <!--Company-->
        <LinearLayout
            android:id="@+id/ll_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/ll_cus_name"
            >

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_company"
                app:tint="@color/color_icon"
                />

            <TextView
                android:id="@+id/tv_Company"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cus_Company"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>
        <!--End company-->

        <!--job-->
        <LinearLayout
            android:id="@+id/ll_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/ll_company"
            >

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_technologi"
                android:contentDescription="@null"
                app:tint="@color/color_icon"/>

            <TextView
                android:id="@+id/tv_job"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="normal"
                android:text="@string/job_infor"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <!-- End job-->

        <!--Day-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/ll_job"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/layout_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/gray_dark" />

                <TextView
                    android:id="@+id/tv_Day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cus_Day"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--End day-->

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mới"
            android:textSize="12.5sp"
            app:chipCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_job" />

        <!--called and comments-->
        <LinearLayout
            android:id="@+id/layout_call_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/top_padding"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/ll_date"
            app:layout_constraintStart_toStartOf="parent">

            <!--Call-->
            <ImageView
                android:id="@+id/number_calls"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_call"
                app:tint="@color/blue_primary"/>

            <TextView
                android:id="@+id/tv_number_calls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>
            <!--End call-->

            <!--Meeting-->
            <ImageView
                android:id="@+id/iv_meeting"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_meeting"
                android:layout_marginStart="16dp"
                app:tint="@color/blue_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_meeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/black"
                android:layout_marginStart="6dp"/>
            <!--End Meeting-->

        </LinearLayout>
        <!--end called and comments-->

        <ImageView
            android:id="@+id/iv_created_by"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/nhanvienlist"
            android:background="@drawable/bg_circle_white"
            android:scaleType="centerCrop"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="@id/layout_call_chat"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <ImageView
            android:id="@+id/iv_sendto"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/nhanvienlist"
            android:background="@drawable/bg_circle_white"
            android:scaleType="centerCrop"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin5"
            android:layout_marginLeft="@dimen/margin5"
            app:layout_constraintTop_toTopOf="@id/layout_call_chat"
            app:layout_constraintEnd_toStartOf="@id/iv_created_by"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>