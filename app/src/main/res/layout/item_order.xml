<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Icon giỏ hàng -->
        <ImageView
            android:id="@+id/ivCart"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_cart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Mã đơn -->
        <TextView
            android:id="@+id/tvOrderCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SO00109"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            app:layout_constraintStart_toEndOf="@id/ivCart"
            app:layout_constraintTop_toTopOf="@id/ivCart"
            app:layout_constraintEnd_toStartOf="@id/ivStar"
            app:layout_constraintHorizontal_bias="0" />

        <!-- Icon sao -->
        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/star"
            app:layout_constraintEnd_toStartOf="@id/tvTag"
            app:layout_constraintTop_toTopOf="@id/tvOrderCode"
            android:layout_marginEnd="6dp"/>

        <!-- Tag "Mới" -->
        <TextView
            android:id="@+id/tvTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Mới"
            android:textSize="12sp"
            android:textColor="#B45309"
            android:background="@drawable/tag_new_bg"
            app:layout_constraintEnd_toStartOf="@id/btnMore"
            app:layout_constraintTop_toTopOf="@id/tvOrderCode"
            android:layout_marginEnd="8dp"/>

        <!-- Nút ... -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:padding="2dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Icon công ty -->
        <ImageView
            android:id="@+id/ivCompany"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_company"
            app:layout_constraintStart_toStartOf="@id/ivCart"
            app:layout_constraintTop_toBottomOf="@id/tvOrderCode"/>

        <!-- Tên công ty -->
        <TextView
            android:id="@+id/tvCompany"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="Công ty TNHH Công nghệ CloudGO"
            android:textSize="14sp"
            android:textColor="#374151"
            app:layout_constraintStart_toEndOf="@id/ivCompany"
            app:layout_constraintTop_toBottomOf="@id/tvOrderCode"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Icon tiền -->
        <ImageView
            android:id="@+id/ivMoney"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/paid"
            app:layout_constraintStart_toStartOf="@id/ivCart"
            app:layout_constraintTop_toBottomOf="@id/tvCompany"/>

        <!-- Giá: tvPrice -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="2.139.000 đ"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@android:color/black"
            app:layout_constraintStart_toEndOf="@id/ivMoney"
            app:layout_constraintTop_toBottomOf="@id/tvCompany"/>

        <!-- Ngày -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="9dp"
            android:text="30/07/2024"
            android:textSize="13sp"
            android:textColor="#6B7280"
            app:layout_constraintStart_toEndOf="@id/tvPrice"
            app:layout_constraintTop_toBottomOf="@id/tvCompany"/>

        <!-- Trạng thái thanh toán (đã bỏ avatar + trao đổi) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Chưa thanh toán"
            android:textSize="12sp"
            android:textColor="#DC2626"
            android:background="@drawable/tag_unpaid_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivMoney"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

