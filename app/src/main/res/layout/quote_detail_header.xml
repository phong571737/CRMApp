<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_action">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="30dp"
            android:layout_height="25dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/margin_action"
            android:layout_marginEnd="@dimen/margin_action"/>

        <TextView
            android:id="@+id/tv_DetailQuote"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:foregroundGravity="center_vertical"
            android:text="@string/quote_detail"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_code"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="@dimen/start_margin"
                android:src="@drawable/ic_quote"
                app:tint="@color/color_icon"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/tv_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/text_name"
                android:text="CODE"
                android:padding="@dimen/start_margin"/>
        </LinearLayout>

        <!--Detatail-->
        <LinearLayout
            android:id="@+id/cl_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/start_margin"
            android:layout_marginEnd="@dimen/start_margin"
            android:layout_marginTop="@dimen/start_margin"
            android:paddingBottom="@dimen/top_padding"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_company"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Công ty TNHH Hyosung Viet Nam"
                android:textColor="@color/seemore_color" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start"
                android:layout_height="wrap_content"
                android:text="Dinh Phuong Nam"
                android:textColor="@color/seemore_color"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>